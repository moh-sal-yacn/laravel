APP_NAME="نظام إدارة مكتب المحاماة"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=ar

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=lawyer_office
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
FILESYSTEM_DISK=public

# Windows / XAMPP fix: forces Blade's compiled-view cache into a folder your
# user account fully owns, avoiding the classic "Access is Denied" file-lock
# error that happens when Laravel tries to write to storage/framework/views
# under XAMPP on Windows.
VIEW_COMPILED_PATH=C:\xampp\htdocs\lawyer-office\blade_cache
